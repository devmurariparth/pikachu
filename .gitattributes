# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Gradle wrapper script must always have LF line endings on Unix/Linux
gradlew text eol=lf
*.sh text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf

# Windows batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.keystore binary
*.jks binary
*.png binary
*.webp binary
